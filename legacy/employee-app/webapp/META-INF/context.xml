<?xml version="1.0" encoding="UTF-8"?>
<Context path="/EmployeeManagmentApp">

    <!-- Connection pool managed by Tomcat. Update url/username/password for your database.
         The PostgreSQL driver jar (lib/provided/postgresql-42.7.4.jar) must be in Tomcat's lib/ folder. -->
    <Resource name="jdbc/EmployeeDB"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="org.postgresql.Driver"
              url="jdbc:postgresql://localhost:5432/employee"
              username="employee_app"
              password=""
              maxTotal="20"
              maxIdle="5"
              maxWaitMillis="10000"
              validationQuery="SELECT 1"/>

    <!-- Session cookie is not sent on cross-site POSTs (CSRF) -->
    <CookieProcessor sameSiteCookies="lax"/>

</Context>
